# AegisGate backend — environment variable template
#
# Copy this file to .env in your local checkout and fill in real values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp .env.example .env       (Linux / macOS)
#   copy .env.example .env     (Windows Command Prompt)

# ── Application ──────────────────────────────────────────────────────────────

# Runtime environment.  Accepted values: development | production | test
APP_ENV=development

# ── Future: Audit / persistence ───────────────────────────────────────────────
# Not used in Milestone 1.  Uncomment when the audit module is implemented.
# AUDIT_DB_PATH=./data/aegisgate_audit.sqlite3

# ── Future: AI provider ───────────────────────────────────────────────────────
# Not used in Milestone 1.  The default model_id is "echo" (no real provider).
# PROVIDER_MODE=mock
# MODEL_API_KEY=your-key-here
